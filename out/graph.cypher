CREATE CONSTRAINT product_id IF NOT EXISTS FOR (n:Product) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT category_id IF NOT EXISTS FOR (n:Category) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT attribute_id IF NOT EXISTS FOR (n:Attribute) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT attrvalue_key IF NOT EXISTS FOR (n:AttrValue) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT tpo_key IF NOT EXISTS FOR (n:TPO) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT scene_id IF NOT EXISTS FOR (n:Scene) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT combo_id IF NOT EXISTS FOR (n:Combo) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT policy_id IF NOT EXISTS FOR (n:Policy) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT trend_period IF NOT EXISTS FOR (n:Trend) REQUIRE n.period IS UNIQUE;
// 재적재 시 추천 결과(간선·콤보)만 지우고 다시 만든다. 상품·텍소노미 노드는 MERGE.
MATCH ()-[r:SUBSTITUTE|COMPLEMENT|IN_TREND]->() DELETE r;
MATCH (c:Combo) DETACH DELETE c;
MERGE (c:Category {id: "SNK"}) SET c.name = "과자", c.definition = "조리 없이 개봉 즉시 먹는 상온 유통 기호식품. 식사가 아니라 간식·안주·디저트 목적.";
MERGE (c:Category {id: "SNK.CHIP"}) SET c.name = "칩", c.definition = "얇은 판 형태로 튀기거나 구워 '바삭/파삭' 식감이 핵심인 스낵.";
MATCH (c:Category {id: "SNK.CHIP"}), (p:Category {id: "SNK"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "SNK.CHIP.POTATO"}) SET c.name = "생감자칩", c.definition = "생감자를 그대로 얇게 썰어 튀긴 칩. 감자 본연의 풍미와 불규칙한 모양이 특징.";
MATCH (c:Category {id: "SNK.CHIP.POTATO"}), (p:Category {id: "SNK.CHIP"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "SNK.CHIP.SHAPED"}) SET c.name = "성형칩", c.definition = "감자·곡물 가루 반죽을 일정한 모양으로 찍어 만든 칩. 모양·두께가 균일하다.";
MATCH (c:Category {id: "SNK.CHIP.SHAPED"}), (p:Category {id: "SNK.CHIP"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "SNK.CHIP.GRAIN"}) SET c.name = "곡물칩", c.definition = "옥수수·통밀 등 곡물 반죽을 판·다층 형태로 만든 칩.";
MATCH (c:Category {id: "SNK.CHIP.GRAIN"}), (p:Category {id: "SNK.CHIP"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "SNK.EXT"}) SET c.name = "팽화·압출 스낵", c.definition = "곡물 반죽을 고압에서 밀어내 부풀린(팽화) 스낵. 가볍고 입에서 부서지는 식감.";
MATCH (c:Category {id: "SNK.EXT"}), (p:Category {id: "SNK"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "SNK.WHEAT"}) SET c.name = "소맥 튀김 스낵", c.definition = "밀가루 반죽을 성형해 튀긴 스낵. 새우·양파 등 시즈닝으로 맛을 낸다. 국내 스낵의 전통 축.";
MATCH (c:Category {id: "SNK.WHEAT"}), (p:Category {id: "SNK"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "SNK.NUT"}) SET c.name = "견과 스낵", c.definition = "견과(주로 땅콩)가 핵심 원료이거나 견과를 반죽으로 감싼 스낵. 안주 성격이 강하다.";
MATCH (c:Category {id: "SNK.NUT"}), (p:Category {id: "SNK"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "BIS"}) SET c.name = "비스킷·쿠키", c.definition = "밀가루 반죽을 오븐에 구운 과자. 튀김이 아니라 '구움'이 공통 제조방식.";
MERGE (c:Category {id: "BIS.CRACKER"}) SET c.name = "크래커", c.definition = "당 함량이 낮고 담백·짭짤한 얇은 구운 과자. 단독 또는 다른 음식과 곁들여 먹는다.";
MATCH (c:Category {id: "BIS.CRACKER"}), (p:Category {id: "BIS"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "BIS.COOKIE"}) SET c.name = "쿠키", c.definition = "버터·설탕 비중이 높아 단맛이 주가 되는 구운 과자. 초코칩 등 첨가물을 넣는 경우가 많다.";
MATCH (c:Category {id: "BIS.COOKIE"}), (p:Category {id: "BIS"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "BIS.WAFER"}) SET c.name = "웨하스·롤", c.definition = "아주 얇게 구운 반죽을 겹치거나 말아 크림을 넣은 과자. 가볍게 부서지는 식감.";
MATCH (c:Category {id: "BIS.WAFER"}), (p:Category {id: "BIS"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "BIS.STICK"}) SET c.name = "스틱", c.definition = "막대 모양 비스킷에 초콜릿 등을 입힌 과자. 한 손으로 집어 먹는 형태가 핵심.";
MATCH (c:Category {id: "BIS.STICK"}), (p:Category {id: "BIS"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "BIS.SANDWICH"}) SET c.name = "샌드", c.definition = "비스킷 두 장 사이에 크림을 넣은 과자.";
MATCH (c:Category {id: "BIS.SANDWICH"}), (p:Category {id: "BIS"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "BIS.CHOUX"}) SET c.name = "슈볼", c.definition = "속이 빈 작은 슈 반죽을 구워 크림을 채운 과자.";
MATCH (c:Category {id: "BIS.CHOUX"}), (p:Category {id: "BIS"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "CAKE"}) SET c.name = "파이·케이크", c.definition = "부드러운 케이크 시트(빵에 가까운 식감)에 크림·마시멜로 등을 넣고 개별포장한 과자.";
MERGE (c:Category {id: "CAKE.CHOCO"}) SET c.name = "초코 코팅 케이크", c.definition = "겉면을 초콜릿으로 코팅한 케이크형 과자.";
MATCH (c:Category {id: "CAKE.CHOCO"}), (p:Category {id: "CAKE"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "CAKE.PLAIN"}) SET c.name = "비코팅 케이크", c.definition = "초콜릿 코팅 없이 시트 자체의 맛(커스터드·버터 등)이 중심인 케이크형 과자.";
MATCH (c:Category {id: "CAKE.PLAIN"}), (p:Category {id: "CAKE"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "CHO"}) SET c.name = "초콜릿", c.definition = "카카오(초콜릿)가 주성분이고 녹는 식감이 중심인 과자.";
MERGE (c:Category {id: "CHO.BAR"}) SET c.name = "판·바 초콜릿", c.definition = "판형이나 막대형으로 성형한 초콜릿. 퍼프·견과·캐러멜 등이 섞이기도 한다.";
MATCH (c:Category {id: "CHO.BAR"}), (p:Category {id: "CHO"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "CDY"}) SET c.name = "캔디·젤리·껌", c.definition = "당류를 굳히거나 졸여 만든 과자. 씹거나 녹여 먹으며 오래 입에 머문다.";
MERGE (c:Category {id: "CDY.JELLY"}) SET c.name = "젤리", c.definition = "젤라틴·펙틴 등으로 굳혀 탄력 있게 씹히는 과자.";
MATCH (c:Category {id: "CDY.JELLY"}), (p:Category {id: "CDY"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "CDY.CHEWY"}) SET c.name = "츄잉캔디", c.definition = "씹으면 늘어나며 녹는 말랑한 캔디. 과일맛·새콤한맛이 주류.";
MATCH (c:Category {id: "CDY.CHEWY"}), (p:Category {id: "CDY"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "CDY.GUM"}) SET c.name = "껌", c.definition = "삼키지 않고 씹기만 하는 과자. 입가심·구취 제거 목적이 강하다.";
MATCH (c:Category {id: "CDY.GUM"}), (p:Category {id: "CDY"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "RMN"}) SET c.name = "라면", c.definition = "건조·유탕 처리한 면과 스프로 구성되어 물·열을 가해 조리하는 즉석 면류. 식사(대용)가 주 목적.";
MERGE (c:Category {id: "RMN.SOUP"}) SET c.name = "국물라면", c.definition = "국물과 함께 먹는 라면. 국물 맛이 제품 정체성의 중심.";
