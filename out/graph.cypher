MERGE (x:Policy {id: "identity"}) SET x.name = "아이덴티티", x.definition = "손님이 '같은 종류'라고 느끼는 단위. 과자·음료는 카테고리 2단계, 라면은 조리형태, 생필품은 카테고리 3단계(용도 안의 품목). 보완재·콤보는 서로 다른 정체성끼리만 묶는다.";
MERGE (x:Policy {id: "substitute"}) SET x.name = "대체재", x.definition = "같은 욕구를 채우는 다른 상품. 같은 type, 같은 목적, 같은 규격대여야 한다.";
MERGE (x:Policy {id: "complement"}) SET x.name = "보완재", x.definition = "함께 소비할 때 가치가 커지는 다른 정체성의 상품. 같은 시간대에 쓸 수 있어야 한다.";
MERGE (x:Policy {id: "combo"}) SET x.name = "콤보", x.definition = "한 TPO 장면에서 함께 사는 상품 묶음. 장면 TPO에 맞고, 정체성이 겹치지 않고, 제한 정책을 지키고, 예산 안이어야 한다.";
MERGE (x:Policy {id: "trend"}) SET x.name = "트렌드", x.definition = "특정 기간에 판매·검색이 평소보다 뜬 상품. TPO 적합성·정책을 통과해야 추천에 쓰인다.";
