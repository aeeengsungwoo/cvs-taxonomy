MERGE (t:TPO {key: "place=사무실·학교"}) SET t.dim = "place", t.dim_name = "장소", t.value = "사무실·학교", t.definition = "뜨거운 물 정도만 있고 냄비 조리는 불가. 동료와 나눠 먹는다. 음주 불가.";
