MATCH (c:Category {id: "RMN.SOUP.UDON"}), (p:Category {id: "RMN.SOUP"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "RMN.DRY"}) SET c.name = "국물없는 라면", c.definition = "면을 삶은 뒤 물을 버리고 소스에 비비거나 볶아 먹는 라면.";
MATCH (c:Category {id: "RMN.DRY"}), (p:Category {id: "RMN"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "RMN.DRY.JJAJANG"}) SET c.name = "짜장", c.definition = "춘장 소스로 비비는 라면.";
MATCH (c:Category {id: "RMN.DRY.JJAJANG"}), (p:Category {id: "RMN.DRY"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "RMN.DRY.FRIED"}) SET c.name = "볶음", c.definition = "매운 양념 소스로 볶듯이 비비는 라면.";
MATCH (c:Category {id: "RMN.DRY.FRIED"}), (p:Category {id: "RMN.DRY"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
