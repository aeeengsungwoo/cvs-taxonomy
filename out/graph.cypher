MERGE (c:Category {id: "RMN.SOUP.MILD"}) SET c.name = "순한·하얀 국물", c.definition = "고추 맛이 약하거나 없는, 사골·곰탕 계열 맑은/하얀 국물 라면.";
MATCH (c:Category {id: "RMN.SOUP.MILD"}), (p:Category {id: "RMN.SOUP"}) MERGE (c)-[:SUBCATEGORY_OF]->(p);
MERGE (c:Category {id: "RMN.SOUP.SEAFOOD"}) SET c.name = "해물·짬뽕 국물", c.definition = "해물 풍미가 중심인 국물 라면. 짬뽕류 포함.";
